# AnchorCare Integration Environment Template
# Copy this file to .env and configure values before starting the apps.

# --- SERVER CONFIGURATION ---
PORT=5000
FRONTEND_PORT=5173

# --- SHARED MONGODB ATLAS CLUSTER ---
# Points directly to the shared 'engram' database
MONGODB_URI=replace-with-your-own-private-value

# --- ANCHORCARE CONFIGURATION & KEYS ---
ANCHORCARE_API_BASE_URL=http://localhost:3000
ANCHORCARE_HOUSEHOLD_ID=anchorcare-demo
ANCHORCARE_PATIENT_ID=demo-person-001

# Caregiver/Admin token for POST /api/engram/episodes and review
ANCHORCARE_ADMIN_KEY=replace-with-your-own-private-value
ANCHORCARE_COMPANION_KEY=replace-with-your-own-private-value

# --- GEMINI MODEL CONFIGURATION ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace-with-your-own-private-value
