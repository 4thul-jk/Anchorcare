# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Engram memory integration. Copy this to a private .env; never commit credentials.
# memory = explicitly labelled local test; mongodb = real Atlas storage.
STORE=memory
MONGODB_URI=
MONGODB_DATABASE=engram
SUBJECT_IDS=demo-person-001
HOUSEHOLD_ID=anchorcare-demo
ANCHORCARE_PATIENT_ID=demo-person-001
TIMEZONE=Europe/London
HOST=127.0.0.1
PORT=3000
# Distinct private backend tokens (used by standalone memory API/config).
ADMIN_TOKEN=replace-with-long-random-admin-token
COMPANION_TOKEN=replace-with-long-random-companion-token
# Separately entered in the local synthetic-data memory workspace.
# Caregiver key authorizes writes; companion key authorizes reads/user reports.
ANCHORCARE_ADMIN_KEY=
ANCHORCARE_COMPANION_KEY=
GEMINI_MODEL=gemini-4-argon
HYBRID_BACKEND=native
EMBEDDING_MODE=auto
SEARCH_INDEX=episodes_text
VECTOR_INDEX=episodes_auto
NATIVE_RERANK=false
CONTEXT_PROCESSING=local
RUN_WORKER=true
