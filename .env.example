# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Engram memory integration. Copy this to a private .env; never commit credentials.
# memory = explicitly labelled local test; mongodb = real Atlas storage.
STORE=memory
MONGODB_URI=
MONGODB_DATABASE=engram
SUBJECT_IDS=demo-person-001
HOUSEHOLD_ID=anchorcare-demo
ANCHORCARE_PATIENT_ID=demo-person-001
TIMEZONE=Europe/London
HOST=127.0.0.1
PORT=3000
# Distinct private backend tokens (used by standalone memory API/config).
ADMIN_TOKEN=replace-with-long-random-admin-token
COMPANION_TOKEN=replace-with-long-random-companion-token
# Separately entered in the local synthetic-data memory workspace.
# Caregiver key authorizes writes; companion key authorizes reads/user reports.
ANCHORCARE_ADMIN_KEY=
ANCHORCARE_COMPANION_KEY=
GEMINI_MODEL=gemini-4-argon
HYBRID_BACKEND=native
EMBEDDING_MODE=auto
SEARCH_INDEX=episodes_text
VECTOR_INDEX=episodes_auto
NATIVE_RERANK=false
CONTEXT_PROCESSING=local
RUN_WORKER=true

# Use the hackathon model for companion replies as well.
GEMINI_COMPANION_MODEL=gemini-4-argon

# Phone-browser demo: HOST=0.0.0.0 permits access from your local network.
# Live calls stay disabled until private provider setup AND caregiver policy approval.
ENABLE_LIVE_SOS_CALLS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SOS_CAREGIVER_NUMBER=

# HTTPS origin when running behind a trusted HTTPS reverse proxy (no trailing slash).
PUBLIC_APP_ORIGIN=
# Persistent Web Push identity. Keep the private key secret; do not regenerate after pairing.
VAPID_SUBJECT=https://github.com/SumeshChodankar/Anchorcare
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Conversation provider: gemini, openrouter (free routes only), or local ollama.
COMPANION_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional localhost-only auto entry for demo-person-001; disabled in production.
DEMO_PATIENT_AUTOLOGIN=false
